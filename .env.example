# ================================================================
# Hướng dẫn setup Firebase:
# 1. Truy cập https://console.firebase.google.com
# 2. Tạo project mới (hoặc dùng project có sẵn)
# 3. Vào Project Settings → General → Your apps → Add app (Web)
# 4. Copy các giá trị firebaseConfig vào bên dưới
# 5. Đổi tên file này thành .env (bỏ .example)
# ================================================================
# Nếu để trống — website vẫn chạy bình thường với localStorage
# Chỉ cần điền nếu muốn sync dữ liệu giữa 2 điện thoại
# ================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
